# ────────────────────────────────────────────────────────────
# TALLY — Environment template
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored — never commit real keys.
# ────────────────────────────────────────────────────────────

# ── Gemini (free key from https://aistudio.google.com) ───────
# Used for the RAG chatbot (chat + embeddings).
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides (have sane defaults)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Firebase (Web app config) ───────────────────────────────
# From Firebase console → Project settings → Your apps → SDK setup.
# Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Backend service-account: set FIREBASE_PROJECT_ID and place the
# private-key JSON at ./firebase-service-account.json (git-ignored).

# ── Census data pull ────────────────────────────────────────
# CENSUS_API_URL=https://api.census.gov.in/api
# CENSUS_ENDPOINT=/data
# CENSUS_USE_LIVE=true

# ── Server (Express) ────────────────────────────────────────
# PORT=8787
# CORS_ORIGIN=*
